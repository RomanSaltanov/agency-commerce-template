# ─── Database ────────────────────────────────────────────────────────────────
# "postgres" — це назва сервісу в docker-compose, не міняти
DATABASE_URL=postgres://medusa:POSTGRES_PASSWORD_HERE@postgres:5432/medusa_db

POSTGRES_USER=medusa
POSTGRES_PASSWORD=POSTGRES_PASSWORD_HERE
POSTGRES_DB=medusa_db

# ─── Redis ───────────────────────────────────────────────────────────────────
# "redis" — це назва сервісу в docker-compose, не міняти
REDIS_URL=redis://redis:6379

# ─── Medusa ──────────────────────────────────────────────────────────────────
# Поки немає домену — вставити IP сервера Hetzner
MEDUSA_BACKEND_URL=http://IP_HETZNER:9000
NODE_ENV=production

# Згенерувати на сервері: openssl rand -hex 32  (запустити двічі)
JWT_SECRET=REPLACE_WITH_OPENSSL_OUTPUT
COOKIE_SECRET=REPLACE_WITH_OPENSSL_OUTPUT

# ─── CORS ────────────────────────────────────────────────────────────────────
# Поки немає домену — вставити IP сервера Hetzner
STORE_CORS=http://IP_HETZNER:8000
ADMIN_CORS=http://IP_HETZNER:9000
AUTH_CORS=http://IP_HETZNER:8000,http://IP_HETZNER:9000

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Заповнити коли підключатимемо оплату (Epic 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_TWqHZw1H_9EFK5p7cV4hCcJdwq6Wp7ddB
RESEND_FROM_EMAIL=noreply@aldevon.co.uk
# URL storefront — потрібен для password reset посилань в листах
NEXT_PUBLIC_BASE_URL=https://shop.aldevon.co.uk

# ─── Cloudflare R2 (Media Storage) ───────────────────────────────────────────
# Заповнити коли підключатимемо медіа (Epic 2)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Заповнити коли підключатимемо Google логін (Epic 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://IP_HETZNER:9000/auth/google/callback

# ─── Feature Flags ───────────────────────────────────────────────────────────
MEDUSA_FF_TRANSLATION=true

# ─── Admin ───────────────────────────────────────────────────────────────────
DISABLE_MEDUSA_ADMIN=false
