# ─── Medusa Backend ───────────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=https://staging-api.yourdomain.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://staging-api.yourdomain.com
NEXT_PUBLIC_BASE_URL=https://staging.yourdomain.com

# Your publishable key from Medusa Admin → Settings → API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# ─── Region ───────────────────────────────────────────────────────────────────
# Default Medusa region ISO-2 code used for pricing until region cookie is set
NEXT_PUBLIC_DEFAULT_REGION=ua

# ─── Cloudflare R2 (Image domains) ────────────────────────────────────────────
# Public hostname only, e.g. media.yourdomain.com (no https://)
CLOUDFLARE_R2_PUBLIC_HOSTNAME=media.yourdomain.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# ─── Google Tag Manager ───────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── Next.js ──────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change_me_generate_with_openssl_rand_hex_32
